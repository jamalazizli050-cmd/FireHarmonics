NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Optional: recent NASA cache freshness, in seconds
FIREHARMONICS_CACHE_TTL_SECONDS=3600

# Optional: uncomment to choose a different local database folder
# FIREHARMONICS_DATA_DIR=FireDetectionAPP/.data

# Optional: ML engine. "disabled" turns the FireLens stage off for every analysis.
# FIREHARMONICS_ML_ENGINE=firelens
# Optional: FireLens checkout (needs src/, data/models/global/, exports/, reports/)
# FIRELENS_ROOT=firelens
# Optional: FireLens data and model folder (models/global must be inside it)
# FIRELENS_DATA_DIR=firelens/data
