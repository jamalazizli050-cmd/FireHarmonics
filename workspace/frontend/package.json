{
  "name": "fireharmonics-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FireHarmonics web frontend (React + TypeScript + Vite) for the FireHarmonics FastAPI backend.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets": "node scripts/derive-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jost": "5.3.0",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-query": "5.107.1",
    "@react-three/fiber": "9.8.2",
    "html-to-image": "1.11.13",
    "jspdf": "4.2.1",
    "lucide-react": "1.73.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "@hookform/resolvers": "7.0.6",
    "react-router": "8.5.1",
    "recharts": "3.10.1",
    "three": "0.187.0",
    "three-globe": "2.45.6",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
