# Copy to .env.local and fill in. Only VITE_* values reach the browser; never put private secrets here.

# Backend location used by the Vite dev/preview proxy (server side only).
FIREHARMONICS_API_TARGET=http://127.0.0.1:8000

# Contact form: Formspree form ID (public by design; Formspree holds the delivery address,
# spam filtering and server-side rate limiting). Leave empty to show the honest "not configured" state.
VITE_FORMSPREE_FORM_ID=

# Geocoding for the location search (Open-Meteo geocoding API, no key required).
VITE_GEOCODER_URL=https://geocoding-api.open-meteo.com/v1/search
